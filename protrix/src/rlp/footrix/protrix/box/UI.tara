dsl konos

use Overview
use Match
use App
use PlayerTrace
use PlayerMatchTrace
use Theme

Service protrixUi as UI(port = "{port}", title = "Protrix", favicon = "")
	Resource("/") home as Page(appTemplate) Main
	Resource("/matches/:matchId") match as Page(appTemplate)
	Resource("/trace") trace as Page(traceTemplate)
	Resource("/player-trace/:playerId") playerTrace as Page(playerTraceTemplate)
	Resource("/minute-player-trace/:playerId") playerMatchTrace as Page(playerMatchTraceTemplate)

Template(layout=Horizontal Flexible) appTemplate as Relative(height=100%, width=100%)
	Block(layout=Vertical Flexible)
		Header(elevation=0, format=spaced secondaryBottomBordered scarletBackground) as Absolute(height=80px)
			TemplateStamp(template=headerTemplate) header

		Block(layout=Horizontal Flexible, format=h100)
			Block(format=h100 scarletBackground) as Absolute(width=200px)
				Selector menu as ListBox
					Block(layout=Horizontal) overviewOpt as Option
						MaterialIcon(icon="Home", format=middleAirRight centeredVertically, color="white")
						Text(value="Inicio", format=h4 centeredVertically, color="white")
			Block(layout=Vertical Flexible, format=spaced) as Relative(width=100%)
				Block(layout=Vertical Flexible CenterCenter) loading > Spinner(format=secondary)

				Block(layout=Vertical Flexible CenterCenter, visible=false) updateRequiredPage
					Text(value="Hay una actualización pendiente. No se puede acceder en estos momentos. Inténtelo más tarde.", format=h4)
					Link(title="Intentar de nuevo", format=airTop) reloadPage as Action

				Block(layout=Vertical Flexible) overviewPage as Conditional > TemplateStamp(template=overviewTemplate) overviewStamp
				Block(layout=Vertical Flexible) matchPage as Conditional > TemplateStamp(template=matchTemplate) matchStamp

Template(layout=Horizontal Flexible) headerTemplate
	Block(layout=Horizontal Flexible Center)
		Block(layout=Vertical CenterCenter, format=relative) as Absolute(height=45px, width=48px)
			//Link(title="", format=homeButton) homeButton as Action
			//Block(layout=Horizontal CenterCenter) as Relative(height=100%, width=100%)
				//Image(defaultValue="images/logo.png", format=fullHeight)

		Text(value="Tagoror: El metaverso de fútbol", format=h3 bold airLeft)
	Block(layout=Horizontal EndJustified Center)
		Text(value="Cargando...") date
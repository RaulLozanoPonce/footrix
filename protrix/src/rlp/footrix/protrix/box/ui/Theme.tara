dsl konos

Theme theme1
	type = Auto

	Typography
		fontSize = 11px

	Primary("#303030")
	Secondary("#AE2E24")
	Error("#f44336")

// FONTS
Format("fontSize:'30pt'") h1
Format("fontSize:'20pt'") h2
Format("fontSize:'16pt'") h3
Format("fontSize:'13pt'") h4
Format("fontSize:'12pt'") h5
Format("fontSize:'9pt'") h6
Format("fontSize:'7pt'") hSmall
Format("fontWeight:'bold'") bold
Format("textAlign:'end'") textEnd
Format("") secondary


// SPACED, AIR
Format("marginLeft:'20px'") doubleAirLeft
Format("marginLeft:'10px'") airLeft
Format("marginTop:'10px'") airTop
Format("marginTop:'5px'") middleAirTop
Format("marginBottom:'10px'") airBottom
Format("marginBottom:'5px'") middleAirBottom
Format("marginRight:'20px'") doubleAirRight
Format("marginRight:'10px'") airRight
Format("marginRight:'5px'") middleAirRight
Format("marginRight:'2px'") smallAirRight

Format("padding:'10px 20px'") spaced
Format("paddingLeft:'10px'") leftSpaced
Format("paddingRight:'10px'") rightSpaced


// BORDERED
Format("border:'2px solid #262626'") bordered
Format("borderLeft:'2px solid #262626'") leftBordered
Format("borderRight:'2px solid #262626'") rightBordered
Format("borderBottom:'2px solid #262626'") bottomBordered
Format("borderBottom:'2px solid #7f211a'") secondaryBottomBordered






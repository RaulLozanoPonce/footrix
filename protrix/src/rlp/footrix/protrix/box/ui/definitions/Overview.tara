dsl konos

use CompetitionCommon
use MatchCommon
use Theme

Template(layout=Horizontal Flexible) overviewTemplate as Relative(height=100%, width=100%)
	Block(layout=Vertical, format=rightSpaced rightBordered) as Absolute(width=500px)
		TemplateStamp(template=matchesTemplate) matchesStamp
	Block(layout=Vertical Flexible, format=leftSpaced rightSpaced) as Relative(width=50%)
		Text(value="Noticias", format=h2 airBottom)
	Block(layout=Vertical Flexible, format=leftSpaced leftBordered) as Relative(width=50%)
		Text(value="Clasificación", format=h2 airBottom)
		Table(itemClass="rlp.footrix.protrix.model.Classification", pageSize=20) classificationTable
			noItemsMessage = "No existen partidos para esta competición"
			noItemsFoundMessage = "No existen partidos para esta competición"
			Mold
				Heading classificationPositionHeading > Text(value = "Pos.", format=bold)
				Item(height=20px, width=10%) classificationPositionMold > Text classificationPosition
			Mold
				Heading classificationTeamHeading > Text(value = "Equipo", format=bold)
				Item(height=20px, width=30%) classificationTeamMold > Text classificationTeam
			Mold
				Heading classificationPlayedMatchesHeading > Text(value = "PJ", format=bold)
				Item(height=20px, width=10%) classificationPlayedMatchesMold > Text classificationPlayedMatches
			Mold
				Heading classificationWinMatchesHeading > Text(value = "V", format=bold)
				Item(height=20px, width=10%) classificationWinMatchesMold > Text classificationWinMatches
			Mold
				Heading classificationDrawMatchesHeading > Text(value = "E", format=bold)
				Item(height=20px, width=10%) classificationDrawMatchesMold > Text classificationDrawMatches
			Mold
				Heading classificationLostMatchesHeading > Text(value = "D", format=bold)
				Item(height=20px, width=10%) classificationLostMatchesMold > Text classificationLostMatches
			Mold
				Heading classificationGoalsDifferenceHeading > Text(value = "DG", format=bold)
				Item(height=20px, width=10%) classificationGoalsDifferenceMold > Text classificationGoalsDifference
			Mold
				Heading classificationPointsHeading > Text(value = "Pts.", format=bold)
				Item(height=20px, width=10%) classificationPointsMold > Text classificationPoints
		Block(format=airTop) as Absolute(height=244px)
			TemplateStamp(template=competitionGoalRankingTemplate) competitionGoalRankingStamp
		Block(format=airTop) as Absolute(height=244px)
			TemplateStamp(template=competitionAssistRankingTemplate) competitionAssistRankingStamp
dsl konos

use Theme

Template(layout=Horizontal) traceTemplate as Relative(height=100%, width=100%)
	Block as Relative(width=15%)
		Grouping(collections=playersTable, pageSize=20) teamGroup as Labeled("Equipo")
		Grouping(collections=playersTable, pageSize=20) positionGroup as Labeled("Posicion")
	Table(itemClass="rlp.footrix.protrix.model.ProtrixPlayer", pageSize=30, format=wh100) playersTable
		noItemsMessage = "No existen jugadores"
		noItemsFoundMessage = "Ningún jugador encontrado para los criterios establecidos"
		Mold
			Heading idHeading > Text(value = "Id")
			Item(height=20px, width=5%) idMold > Number id
		Mold
			Heading nameHeading > Text(value = "Nombre")
			Item(height=20px, width=20%) nameMold > Link(title = "nombre") name
		Mold
			Heading teamHeading > Text(value = "Equipo")
			Item(height=20px, width=15%) teamMold > Text team
		Mold
			Heading roleHeading > Text(value = "Rol")
			Item(height=20px, width=10%) roleMold > Text role
		Mold
			Heading overallHeading > Text(value = "Media")
			Item(height=20px, width=5%) overallMold > Number overall
		Mold
			Heading positionHeading > Text(value = "Posicion")
			Item(height=20px, width=5%) positionMold > Text position
		Mold
			Heading happinessContractHeading > Text(value = "Fel (Con.)")
			Item(height=20px, width=5%) happinessContractMold > Number(countDecimals = 2) happinessContract
		Mold
			Heading happinessGameTimeHeading > Text(value = "Fel (TJu.)")
			Item(height=20px, width=5%) happinessGameTimeMold > Number(countDecimals = 2) happinessGameTime
		Mold
			Heading happinessIndividualHeading > Text(value = "Fel (Ind.)")
			Item(height=20px, width=5%) happinessIndividualMold > Number(countDecimals = 2) happinessIndividual
		Mold
			Heading happinessCollectiveHeading > Text(value = "Fel (Col.)")
			Item(height=20px, width=5%) happinessCollectiveMold > Number(countDecimals = 2) happinessCollective
		Mold
			Heading minutesHeading > Text(value = "Min. (%)")
			Item(height=20px, width=5%) minutesMold > Number(countDecimals = 2) minutes
		Mold
			Heading scoreHeading > Text(value = "Punt.")
			Item(height=20px, width=5%) scoreMold > Number(countDecimals = 2) score
		Mold
			Heading cacheIniHeading > Text(value = "Cache Ini (%)")
			Item(height=20px, width=5%) cacheIniMold > Number(countDecimals = 2) cacheIni
		Mold
			Heading cacheHeading > Text(value = "Cache (%)")
			Item(height=20px, width=5%) cacheMold > Number(countDecimals = 2) cache